# 기본 모드: 서버 없이 원본 앱 화면과 기능 흐름을 체험합니다.
VITE_AUTH_MODE=demo
# 선택: server로 바꾸면 첨부 Spring 서버의 로그인·영수증 OCR API를 사용합니다.
# 구독·커뮤니티·프로필 저장은 두 모드 모두 브라우저 로컬 저장소입니다.
# VITE_AUTH_MODE=server
# 비우면 개발 서버의 /auth, /api 프록시를 사용합니다.
VITE_API_URL=
# 개발 프록시 대상은 실행 환경변수로 지정합니다.
# API_PROXY_TARGET=http://localhost:8080 npm run dev
