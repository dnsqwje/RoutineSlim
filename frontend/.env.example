# 별도로 실행하는 백엔드 주소. 개발/미리보기 프록시에서 사용합니다.
API_PROXY_TARGET=http://localhost:8080
# 원본 웹 API 유지: original (기본값)
# 첨부 RoutineSlim-Server-dev의 로그인/구독 API 연결: server-dev
VITE_API_MODE=original
# 운영에서 API가 다른 출처에 있으면 URL을 지정합니다. 비우면 동일 출처.
VITE_API_BASE_URL=
# server-dev 카테고리 ID는 해당 서버 DB의 실제 ID를 확인해 설정하세요.
# 예: {"영상":1,"음악":2}. 예시 ID를 실제 ID로 가정하지 않습니다.
VITE_SERVER_CATEGORY_IDS={}
